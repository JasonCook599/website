---
title: UniFi Option 43 Converter
---
<div class="grid-container">
  <div class="label">
    <label for="inputFQDN">FQDN:</label>
  </div>
  <div class="input">
    <input
      type="text"
      id="inputFQDN"
      placeholder="Inform URI"
      oninput="convertText()">
  </div>
  <div class="label">
    <label for="inputIPv4">IPv4:</label>
  </div>
  <div class="input">
    <input
      type="text"
      id="inputIPv4"
      placeholder="IPv4 Address"
      oninput="convertText()"
      class="nice-input">
  </div>
  <div class="label">Hex:</div>
  <div id="outputHex" class="mono"></div>
  <div class="label">Colon:</div>
  <div id="outputHexColon" class="mono"></div>
</div>